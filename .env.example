# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3000

# ─── Angel One (SmartAPI) — live WebSocket feed ───────────────────────────────
# ANGEL_API_KEY is required for the live Angel feed; without it the server
# falls back to mock/simulated data automatically.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
# Optional static JWT (instead of password + TOTP login)
ANGEL_JWT_TOKEN=
ANGEL_LOCAL_IP=192.168.1.100
ANGEL_PUBLIC_IP=106.193.147.98
ANGEL_MAC_ADDRESS=18:c0:4d:2b:80:75

# ─── Fyers — polling fallback feed ───────────────────────────────────────────
FYERS_ACCESS_TOKEN=
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=http://127.0.0.1:5001
