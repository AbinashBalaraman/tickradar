# ─── Server Configuration ───────────────────────────────────────────────────
PORT=3100
NODE_ENV="production"

# ─── Angel One (SmartAPI) — Primary Live WebSocket Feed ───────────────────────
# Enter your Angel One credentials below to enable live streaming market data.
ANGEL_API_KEY="ANGEL_API_KEY"
ANGEL_CLIENT_CODE="ANGEL_CLIENT_CODE"
ANGEL_PASSWORD="ANGEL_PASSWORD"
ANGEL_TOTP_SECRET="ANGEL_TOTP_SECRET"

# ─── Fyers API — Secondary Polling Feed (Optional) ───────────────────────────
FYERS_ACCESS_TOKEN="FYERS_ACCESS_TOKEN"
FYERS_CLIENT_ID="FYERS_CLIENT_ID"
FYERS_SECRET_KEY="FYERS_SECRET_KEY"
FYERS_REDIRECT_URI="http://127.0.0.1:5001"


